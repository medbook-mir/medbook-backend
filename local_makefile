build:
	docker compose -f docker-compose-local.yml up -d --build --remove-orphans

up:
	docker compose -f docker-compose-local.yml up

restart:
	docker compose -f docker-compose-local.yml restart

down:
	docker compose -f docker-compose-local.yml down

down-v:
	docker compose -f docker-compose-local.yml down -v

django-logs:
	docker compose -f docker-compose-local.yml logs web

test:
	docker compose -f docker-compose-local.yml exec backend pytest src/medbook/tests/ -v --color=yes

logs-frontend:
	docker compose -f docker-compose-local.yml medbook-frontend-1 --tail=100 -f

logs-backend:
	docker compose -f docker-compose-local.yml medbook-backend-1 --tail=100 -f

logs-db:
	docker compose -f docker-compose-local.yml medbook-db-1 --tail=100 -f

shell-backend:
	docker exec -it medbook-backend-1 sh

status:
	docker ps --filter "name=medbook-*"