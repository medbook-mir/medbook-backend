POSTGRES_DB=medbook
POSTGRES_USER=medbook_user
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

DJANGO_SETTINGS_MODULE=medbook.settings.local

SECRET_KEY=yoursecretkey 
DEBUG=1  
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend 
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=superuser@example.com
DJANGO_SUPERUSER_PASSWORD=super_secure_password 
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=admin_secure_password

VITE_API_URL=http://backend:8000 
API_BASE_URL=/api/v1/

JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=UTC

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=your_email@yandex.ru
EMAIL_HOST_PASSWORD=your_email_password

TWILIO_ACCOUNT_SID=srdt_your_twilio_account_sid
TWILIO_AUTH_TOKEN=twilio_your_auth_token
TWILIO_PHONE_NUMBER=twilio_your_phone_number

GOOGLE_AUTH_CLIENT_ID=google_your_client_id
GOOGLE_AUTH_CLIENT_SECRET=google_your_client_secret

SERVICE_TYPE=backend
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8001


SERVICE_TYPE_API=api
DJANGO_ALLOWED_HOSTS_API=localhost,127.0.0.1
PORT_API=8001
CORS_ALLOWED_ORIGINS_API=http://localhost:8000,http://localhost:8001

DJANGO_DEBUG=true
STATIC_ROOT=/app/src/staticfiles

VITE_ALLOWED_HOST=medbook-hlti.onrender.com